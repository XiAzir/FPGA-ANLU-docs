					<net name="u1_rx/u2_timging_chk/p_cnt[2]"/>
					<net name="u1_rx/u2_timging_chk/p_cnt[1]"/>
					<net name="u1_rx/u2_timging_chk/p_cnt[0]"/>
				</bus>
				<net name="u1_rx/u2_timging_chk/time_1s_flag" op="equal"/>
				<net name="u1_rx/de" op="equal"/>
				<net name="u1_rx/u2_timging_chk/test_flag[2]" op="equal"/>
				<net name="u1_rx/u2_timging_chk/test_flag[1]" op="equal"/>
				<net name="u1_rx/u2_timging_chk/test_flag[0]" op="equal"/>
			</watcher_nodes>
		</signal_vec>
		<trigger name="auto_chipwatcher_0_trigger" position="pre">
			<condition level="1" enabled="yes" type="basic_and">
				u1_rx/de == any && u1_rx/u2_timging_chk/de_f == any && u1_rx/u2_timging_chk/test_flag[0] == any && u1_rx/u2_timging_chk/test_flag[1] == any && u1_rx/u2_timging_chk/test_flag[2] == any && u1_rx/u2_timging_chk/time_1s_flag == any && u1_rx/u2_timging_chk/vsync_f == rising
			</condition>
			<log>
				<data name="log: 2020/ 8/26 22:46:33" trigger_en="yes" trigger_pos="171" sample_num="512">
					
				</data>
			</log>
		</trigger>
	</instance>
</chipwatcher>
