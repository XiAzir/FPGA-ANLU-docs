				<net name="u1_rx/u2_timging_chk/row_cnt[8]"/>
				<net name="u1_rx/u2_timging_chk/row_cnt[9]"/>
				<net name="u1_rx/u2_timging_chk/test_flag[0]"/>
				<net name="u1_rx/u2_timging_chk/test_flag[1]"/>
				<net name="u1_rx/u2_timging_chk/test_flag[2]"/>
				<net name="u1_rx/u2_timging_chk/time_1s_flag"/>
				<net name="u1_rx/u2_timging_chk/v_cnt[0]"/>
				<net name="u1_rx/u2_timging_chk/v_cnt[1]"/>
				<net name="u1_rx/u2_timging_chk/v_cnt[2]"/>
				<net name="u1_rx/u2_timging_chk/v_cnt[3]"/>
				<net name="u1_rx/u2_timging_chk/v_cnt[4]"/>
				<net name="u1_rx/u2_timging_chk/v_cnt[5]"/>
				<net name="u1_rx/u2_timging_chk/v_cnt[6]"/>
				<net name="u1_rx/u2_timging_chk/vsync_f"/>
			</data_nets>
			<watcher_nodes>
				<net name="u1_rx/u2_timging_chk/vsync_f" op="equal"/>
				<net name="u1_rx/u2_timging_chk/de_f" op="equal"/>
				<bus name="u1_rx/u2_timging_chk/v_cnt" radix="undec" state="collapse" op="dont_care">
					<net name="u1_rx/u2_timging_chk/v_cnt[6]"/>
					<net name="u1_rx/u2_timging_chk/v_cnt[5]"/>
					<net name="u1_rx/u2_timging_chk/v_cnt[4]"/>
