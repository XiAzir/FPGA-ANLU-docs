<chipwatcher project_name="hdmi_loop" bit_file="hdmi_loop.bit" bid_file="hdmi_loop_inst.bid" chip_name="EG4S20CG324">
	<instance name="auto_chipwatcher_0" id="0" enabled="yes">
		<clock clk_name="rx_pclk" polarity="posedge"/>
		<config bram_name="auto_chipwatcher_0_logicbram" sample_depth="512"/>
		<signal_vec>
			<trigger_nets>
				<net name="u1_rx/de"/>
				<net name="u1_rx/u2_timging_chk/de_f"/>
				<net name="u1_rx/u2_timging_chk/test_flag[0]"/>
				<net name="u1_rx/u2_timging_chk/test_flag[1]"/>
				<net name="u1_rx/u2_timging_chk/test_flag[2]"/>
				<net name="u1_rx/u2_timging_chk/time_1s_flag"/>
				<net name="u1_rx/u2_timging_chk/vsync_f"/>
			</trigger_nets>
			<data_nets>
				<net name="u1_rx/de"/>
				<net name="u1_rx/u2_timging_chk/de_f"/>
				<net name="u1_rx/u2_timging_chk/p_cnt[0]"/>
				<net name="u1_rx/u2_timging_chk/p_cnt[10]"/>
				<net name="u1_rx/u2_timging_chk/p_cnt[1]"/>
				<net name="u1_rx/u2_timging_chk/p_cnt[2]"/>
