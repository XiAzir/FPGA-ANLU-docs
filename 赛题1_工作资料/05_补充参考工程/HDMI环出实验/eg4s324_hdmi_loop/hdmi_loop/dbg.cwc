					<net name="u1_rx/u2_timging_chk/row_cnt[4]"/>
					<net name="u1_rx/u2_timging_chk/row_cnt[3]"/>
					<net name="u1_rx/u2_timging_chk/row_cnt[2]"/>
					<net name="u1_rx/u2_timging_chk/row_cnt[1]"/>
					<net name="u1_rx/u2_timging_chk/row_cnt[0]"/>
				</bus>
				<bus name="u1_rx/u2_timging_chk/p_cnt" radix="undec" state="collapse" op="dont_care">
					<net name="u1_rx/u2_timging_chk/p_cnt[10]"/>
					<net name="u1_rx/u2_timging_chk/p_cnt[9]"/>
					<net name="u1_rx/u2_timging_chk/p_cnt[8]"/>
					<net name="u1_rx/u2_timging_chk/p_cnt[7]"/>
					<net name="u1_rx/u2_timging_chk/p_cnt[6]"/>
